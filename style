us: 28px;<br/>  background: linear-gradient(180deg, rgba(16, 65, 44, 0.55) 0%, rgba(5, 23, 16, 0.85) 100%);<br/>  border: 1px solid var(--gold-border);<br/>  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);<br/>}<br/><br/>.hero-badge {<br/>  display: inline-block;<br/>  padding: 5px 14px;<br/>  border-radius: 999px;<br/>  background: rgba(212, 175, 55, 0.15);<br/>  border: 1px solid var(--gold-border);<br/>  color: var(--gold-light);<br/>  font-size: 12px;<br/>  font-weight: 600;<br/>  margin-bottom: 12px;<br/>}<br/><br/>.hero-title {<br/>  font-family: &#39;Cinzel&#39;, serif;<br/>  font-size: clamp(36px, 5vw, 62px);<br/>  font-weight: 800;<br/>  letter-spacing: 3px;<br/>  background: linear-gradient(to bottom, #ffffff 10%, #ffe28a 55%, #c59b27 100%);<br/>  -webkit-background-clip: text;<br/>  -webkit-text-fill-color: transparent;<br/>  filter: drop-shadow(0 4px 18px rgba(212, 175, 55, 0.35));<br/>}<br/><br/>.hero-subtitle {<br/>  font-family: &#39;Cinzel&#39;, serif;<br/>  font-size: clamp(16px, 2vw, 22px);<br/>  color: #e8f5ee;<br/>  margin-top: 4px;<br/>  margin-bottom: 14px;<br/>}<br/><br/>.hero-pillars {<br/>  display: flex;<br/>  justify-content: center;<br/>  flex-wrap: wrap;<br/>  gap: 12px;<br/>  font-size: 13px;<br/>  font-weight: 600;<br/>  color: var(--gold-light);<br/>}<br/><br/>.hero-pillars span::after {<br/>  content: &quot;•&quot;;<br/>  margin-left: 12px;<br/>  color: var(--gold-main);<br/>}<br/><br/>.hero-pillars span:last-child::after {<br/>  content: &quot;&quot;;<br/>}<br/><br/>/* 6-Card Grid */<br/>.cards-container {<br/>  max-width: 1380px;<br/>  margin: 0 auto 40px;<br/>  padding: 0 24px;<br/>  display: grid;<br/>  grid-template-columns: repeat(6, 1fr);<br/>  gap: 16px;<br/>}<br/><br/>@media (max-width: 1200px) {<br/>  .cards-container {<br/>    grid-template-columns: repeat(3, 1fr);<br/>  }<br/>}<br/><br/>@media (max-width: 680px) {<br/>  .cards-container {<br/>    grid-template-columns: repeat(2, 1fr);<br/>  }<br/>}<br/><br/>.portal-card {<br/>  border-radius: 20px;<br/>  padding: 24px 16px;<br/>  text-align: center;<br/>  border: 1.5px solid var(--gold-border);<br/>  display: flex;<br/>  flex-direction: column;<br/>  justify-content: space-between;<br/>  align-items: center;<br/>  cursor: pointer;<br/>  transition: transform 0.3s ease, box-shadow 0.3s ease;<br/>  position: relative;<br/>  overflow: hidden;<br/>  min-height: 290px;<br/>}<br/><br/>.portal-card:hover {<br/>  transform: translateY(-6px);<br/>  box-shadow: 0 16px 35px rgba(0, 0, 0, 0.6), 0 0 20px rgba(212, 175, 55, 0.35);<br/>}<br/><br/>.card-quotes {<br/>  background: linear-gradient(180deg, #42290a 0%, #170e04 100%);<br/>}<br/><br/>.card-science {<br/>  background: linear-gradient(180deg, #092c47 0%, #04121f 100%);<br/>}<br/><br/>.card-discoveries {<br/>  background: linear-gradient(180deg, #3c2609 0%, #140c03 100%);<br/>}<br/><br/>.card-language {<br/>  background: linear-gradient(180deg, #093b29 0%, #031710 100%);<br/>}<br/><br/>.card-spiritual {<br/>  background: linear-gradient(180deg, #47280a 0%, #1a0d03 100%);<br/>}<br/><br/>.card-aivideos {<br/>  background: linear-gradient(180deg, #271247 0%, #0e061c 100%);<br/>}<br/><br/>.card-icon {<br/>  font-size: 46px;<br/>  margin-bottom: 14px;<br/>  filter: drop-shadow(0 0 14px rgba(255, 226, 138, 0.6));<br/>}<br/><br/>.portal-card h3 {<br/>  font-family: &#39;Cinzel&#39;, serif;<br/>  font-size: 19px;<br/>  font-weight: 700;<br/>  color: #fff;<br/>  margin-bottom: 8px;<br/>  line-height: 1.25;<br/>}<br/><br/>.portal-card p {<br/>  font-size: 12.5px;<br/>  color: #d0dfd8;<br/>  margin-bottom: 18px;<br/>  line-height: 1.4;<br/>}<br/><br/>.explore-btn {<br/>  padding: 8px 20px;<br/>  border-radius: 999px;<br/>  border: 1px solid var(--gold-light);<br/>  background: rgba(0, 0, 0, 0.35);<br/>  color: var(--gold-light);<br/>  font-size: 12.5px;<br/>  font-weight: 600;<br/>  transition: all 0.2s ease;<br/>}<br/><br/>.portal-card:hover .explore-btn {<br/>  background: var(--gold-light);<br/>  color: #061a13;<br/>}<br/><br/>/* Dynamic Workspace Section */<br/>.workspace {<br/>  max-width: 1340px;<br/>  margin: 0 auto 60px;<br/>  padding: 32px;<br/>  border-radius: 24px;<br/>  background: var(--glass-dark);<br/>  border: 1.5px solid var(--gold-border);<br/>  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.55);<br/>  backdrop-filter: blur(14px);<br/>}<br/><br/>.workspace-header {<br/>  display: flex;<br/>  justify-content: space-between;<br/>  align-items: center;<br/>  flex-wrap: wrap;<br/>  gap: 16px;<br/>  padding-bottom: 18px;<br/>  border-bottom: 1px solid rgba(212, 175, 55, 0.25);<br/>  margin-bottom: 24px;<br/>}<br/><br/>.workspace-header h2 {<br/>  font-family: &#39;Cinzel&#39;, serif;<br/>  font-size: 26px;<br/>  color: var(--gold-light);<br/>}<br/><br/>/* Vignanam-Style Spiritual Script Switcher */<br/>.script-bar {<br/>  display: flex;<br/>  flex-wrap: wrap;<br/>  gap: 8px;<br/>  margin-bottom: 20px;<br/>}<br/><br/>.script-btn {<br/>  padding: 6px 14px;<br/>  border-radius: 8px;<br/>  border: 1px solid var(--gold-border);<br/>  background: rgba(255, 255, 255, 0.05);<br/>  color: var(--text-light);<br/>  font-size: 12.5px;<br/>  font-weight: 600;<br/>  cursor: pointer;<br/>}<br/><br/>.script-btn.active {<br/>  background: var(--gold-main);<br/>  color: #04150f;<br/>}<br/><br/>.content-grid {<br/>  display: grid;<br/>  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));<br/>  gap: 20px;<br/>}<br/><br/>.item-box {<br/>  background: rgba(255, 255, 255, 0.04);<br/>  border: 1px solid rgba(212, 175, 55, 0.25);<br/>  border-radius: 16px;<br/>  padding: 20px;<br/>  transition: border-color 0.2s;<br/>}<br/><br/>.item-box:hover {<br/>  border-color: var(--gold-light);<br/>}<br/><br/>.item-tag {<br/>  font-size: 11px;<br/>  text-transform: uppercase;<br/>  letter-spacing: 1px;<br/>  color: var(--gold-light);<br/>  margin-bottom: 8px;<br/>  display: block;<br/>  font-weight: 700;<br/>}<br/><br/>.item-box h4 {<br/>  font-size: 18px;<br/>  margin-bottom: 10px;<br/>  color: #fff;<br/>}<br/><br/>.item-box p {<br/>  font-size: 14px;<br/>  color: var(--text-muted);<br/>  line-height: 1.65;<br/>  white-space: pre-line;<br/>}<br/><br/>.action-pill {<br/>  margin-top: 14px;<br/>  display: inline-block;<br/>  padding: 6px 14px;<br/>  border-radius: 999px;<br/>  background: rgba(34, 197, 94, 0.2);<br/>  border: 1px solid rgba(34, 197, 94, 0.5);<br/>  color: #86efac;<br/>  font-size: 12px;<br/>  font-weight: 600;<br/>  cursor: pointer;<br/>}<br/><br/>/* Modal Popup */<br/>.modal-backdrop {<br/>  display: none;<br/>  position: fixed;<br/>  inset: 0;<br/>  background: rgba(2, 10, 7, 0.85);<br/>  backdrop-filter: blur(8px);<br/>  z-index: 100;<br/>  place-items: center;<br/>  padding: 20px;<br/>}<br/><br/>.modal-box {<br/>  max-width: 560px;<br/>  width: 100%;<br/>  background: #072117;<br/>  border: 1.5px solid var(--gold-main);<br/>  border-radius: 20px;<br/>  padding: 28px;<br/>  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);<br/>}<br/><br/>.modal-box h3 {<br/>  font-family: &#39;Cinzel&#39;, serif;<br/>  color: var(--gold-light);<br/>  margin-bottom: 12px;<br/>  font-size: 22px;<br/>}<br/><br/>.modal-box p {<br/>  color: #e2ede8;<br/>  line-height: 1.7;<br/>  margin-bottom: 20px;<br/>  white-space: pre-line;<br/>}<br/><br/>.close-btn {<br/>  padding: 8px 20px;<br/>  border-radius: 999px;<br/>  background: var(--gold-main);<br/>  color: #04150f;<br/>  font-weight: 700;<br/>  border: none;<br/>  cursor: pointer;<br/>}<br/><br/>footer {<br/>  text-align: center;<br/>  padding: 24px;<br/>  border-top: 1px solid rgba(212, 175, 55, 0.2);<br/>  color: var(--text-muted);<br/>  font-size: 13px;<br/>}<br/></body>

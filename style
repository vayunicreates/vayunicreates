<body>:root {<br/>  --bg-deep: #04150f;<br/>  --bg-forest: #082419;<br/>  --gold-light: #ffe28a;<br/>  --gold-main: #d4af37;<br/>  --gold-border: rgba(212, 175, 55, 0.45);<br/>  --glass-dark: rgba(6, 26, 19, 0.85);<br/>  --text-light: #f4f7f5;<br/>  --text-muted: #b8cdc3;<br/>}<br/><br/>* {<br/>  box-sizing: border-box;<br/>  margin: 0;<br/>  padding: 0;<br/>}<br/><br/>body {<br/>  font-family: &#39;Plus Jakarta Sans&#39;, sans-serif;<br/>  background: radial-gradient(circle at 50% 18%, #134e35 0%, var(--bg-forest) 45%, var(--bg-deep) 100%);<br/>  color: var(--text-light);<br/>  min-height: 100vh;<br/>  overflow-x: hidden;<br/>}<br/><br/>/* Decorative Ambient Glows */<br/>.ambient-glow {<br/>  position: fixed;<br/>  width: 600px;<br/>  height: 600px;<br/>  border-radius: 50%;<br/>  filter: blur(130px);<br/>  z-index: -1;<br/>  pointer-events: none;<br/>  opacity: 0.35;<br/>}<br/><br/>.glow-1 {<br/>  top: -150px;<br/>  left: 20%;<br/>  background: #22c55e;<br/>}<br/><br/>.glow-2 {<br/>  top: 100px;<br/>  right: 10%;<br/>  background: #eab308;<br/>}<br/><br/>/* Top Navigation Header */<br/>header {<br/>  max-width: 1380px;<br/>  margin: 0 auto;<br/>  padding: 18px 24px;<br/>  display: flex;<br/>  align-items: center;<br/>  justify-content: space-between;<br/>  gap: 16px;<br/>  flex-wrap: wrap;<br/>}<br/><br/>.brand {<br/>  display: flex;<br/>  align-items: center;<br/>  gap: 12px;<br/>  cursor: pointer;<br/>  text-decoration: none;<br/>}<br/><br/>.brand-icon {<br/>  width: 46px;<br/>  height: 46px;<br/>  border-radius: 12px;<br/>  background: linear-gradient(135deg, #22c55e, #d4af37);<br/>  display: grid;<br/>  place-items: center;<br/>  font-family: &#39;Cinzel&#39;, serif;<br/>  font-weight: 800;<br/>  font-size: 26px;<br/>  color: #04150f;<br/>  box-shadow: 0 0 20px rgba(212, 175, 55, 0.5);<br/>}<br/><br/>.brand-text h1 {<br/>  font-family: &#39;Cinzel&#39;, serif;<br/>  font-size: 24px;<br/>  letter-spacing: 2px;<br/>  background: linear-gradient(to bottom, #fff3c